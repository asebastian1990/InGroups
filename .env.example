DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Clerk — use VITE_ prefix for the Vite client (not NEXT_PUBLIC_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Client — tell Clerk OAuth to return to your app, not Account Portal (set in Cloudflare too)
# VITE_CLERK_SIGN_IN_URL=https://ingroups.pages.dev/
# VITE_CLERK_SIGN_UP_URL=https://ingroups.pages.dev/
# VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=https://ingroups.pages.dev/
# VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=https://ingroups.pages.dev/

# Production — client connects to Railway game server (Socket.io)
VITE_SERVER_URL=https://your-app.up.railway.app

# Production — comma-separated Cloudflare Pages URLs allowed by the server
CORS_ORIGIN=https://ingroups.pages.dev,https://your-custom-domain.com

# Allow play-only guest connections (set to false to require sign-in)
ALLOW_GUEST=true
